{
  "connector.class": "org.apache.rocketmq.connect.debezium.postgres.DebeziumPostgresConnector",
  "max.task": "1",
  "connect.topicname": "debezium-pg-source",
  "kafka.transforms": "Reroute,Unwrap,TsCreatedAt,TsUpdatedAt",
  "kafka.transforms.Reroute.type": "io.debezium.transforms.ByLogicalTableRouter",
  "kafka.transforms.Reroute.topic.regex": "(.*)",
  "kafka.transforms.Reroute.topic.replacement": "debezium-pg-source",
  "kafka.transforms.Unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "kafka.transforms.Unwrap.delete.handling.mode": "none",
  "kafka.transforms.Unwrap.add.headers": "op,source.db,source.table",
  "database.history.skip.unparseable.ddl": true,

  "comment.time": "===== 【时间精度】connect 模式：timestamp(4-6) → 秒级 epoch，避免微秒 bigint =====",
  "time.precision.mode": "connect",

  "comment.snapshot": "强制每次启动都 snapshot，确保历史数据全量同步",
  "snapshot.mode": "always",

  "comment.kafka.transforms.ts": "【核心】两个独立 TimestampConverter（逗号分隔已验证不兼容）",
  "kafka.transforms.TsCreatedAt.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "kafka.transforms.TsCreatedAt.target.type": "string",
  "kafka.transforms.TsCreatedAt.format": "yyyy-MM-dd HH:mm:ss.SSS",
  "kafka.transforms.TsCreatedAt.field": "created_at",

  "kafka.transforms.TsUpdatedAt.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "kafka.transforms.TsUpdatedAt.target.type": "string",
  "kafka.transforms.TsUpdatedAt.format": "yyyy-MM-dd HH:mm:ss.SSS",
  "kafka.transforms.TsUpdatedAt.field": "updated_at",

  "database.server.name": "pgserver",
  "database.port": "5432",
  "database.hostname": "pg-source",
  "database.connectionTimeZone": "UTC",
  "database.user": "source_user",
  "database.dbname": "source_db",
  "database.password": "source_pass",
  "plugin.name": "pgoutput",
  "publication.name": "pg_orders_pub",
  "slot.name": "pg_orders_slot",
  "table.whitelist": "public.orders",
  "key.converter": "org.apache.rocketmq.connect.runtime.converter.record.json.JsonConverter",
  "value.converter": "org.apache.rocketmq.connect.runtime.converter.record.json.JsonConverter"
}
